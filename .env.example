# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Watches each video once
GEMINI_MODEL=gemini-3.5-flash-lite
# Answers questions; try a bigger Flash model if diagrams come out sloppy
GEMINI_TUTOR_MODEL=gemini-3.5-flash-lite

# Show "Continue with Google" once OAuth is configured in Supabase
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Stripe (Dashboard → Developers → API keys). Use test keys (sk_test_/pk_test_) while developing.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the webhook endpoint you create in the Dashboard
STRIPE_WEBHOOK_SECRET=
